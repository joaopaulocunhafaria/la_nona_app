{
	"name": "@lanona/web",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve --configuration development --host 0.0.0.0",
		"build": "ng build",
		"build-homolog": "ng build --configuration homolog",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"test:ci": "ng test --watch=false --browsers=ChromeHeadless",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"e2e:relatorio": "playwright show-report e2e-relatorio",
		"typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.e2e.json"
	},
	"private": true,
	"dependencies": {
		"@angular/common": "^19.2.0",
		"@angular/compiler": "^19.2.0",
		"@angular/core": "^19.2.0",
		"@angular/forms": "^19.2.0",
		"@angular/platform-browser": "^19.2.0",
		"@angular/platform-browser-dynamic": "^19.2.0",
		"@angular/router": "^19.2.0",
		"@lanona/shared": "*",
		"@ng-select/ng-select": "^14.9.0",
		"@primeng/themes": "^19.1.4",
		"@supabase/supabase-js": "^2.119.0",
		"@tailwindcss/postcss": "^4.3.1",
		"@tailwindcss/vite": "^4.3.1",
		"autoprefixer": "^10.5.0",
		"chart.js": "^4.5.1",
		"date-fns": "^4.4.0",
		"decimal.js": "^10.6.0",
		"ngx-mask": "^19.0.7",
		"postcss": "^8.5.15",
		"primeicons": "^7.0.0",
		"primeng": "^19.1.4",
		"rxjs": "~7.8.0",
		"tailwindcss": "^4.3.1",
		"tslib": "^2.3.0",
		"zone.js": "~0.15.0"
	},
	"devDependencies": {
		"@angular-devkit/build-angular": "^19.2.27",
		"@angular/cli": "^19.2.27",
		"@angular/compiler-cli": "^19.2.0",
		"@playwright/test": "^1.65.1",
		"@types/jasmine": "~5.1.0",
		"@types/node": "^22.10.0",
		"jasmine-core": "~5.6.0",
		"karma": "~6.4.0",
		"karma-chrome-launcher": "~3.2.0",
		"karma-coverage": "~2.2.0",
		"karma-jasmine": "~5.1.0",
		"karma-jasmine-html-reporter": "~2.1.0",
		"typescript": "~5.7.2"
	}
}
